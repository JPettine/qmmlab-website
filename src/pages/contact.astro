---
import { existsSync, readFileSync } from 'node:fs';
import { join } from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';

const readContactText = (fileName: string) => {
  const filePath = join(process.cwd(), 'public', 'contact', fileName);
  return existsSync(filePath) ? readFileSync(filePath, 'utf8').trim() : '';
};

const openingsContent = readContactText('openings.txt');
const [openingsTitle = 'Join the QMM Lab!', ...openingsParagraphs] = openingsContent
  .split(/\r?\n\r?\n/)
  .map((part) => part.trim())
  .filter(Boolean);
const contactText = readContactText('contact.txt') || 'For lab inquiries, recruiting questions, and visitor information, contact Prof. Pettine directly';
const addressLines = ['Department of Physics and Astronomy', 'Stony Brook University', 'Stony Brook, NY 11790'];
---

<BaseLayout title="Contact | QMM Lab" description="Contact and recruiting information for QMM Lab.">
  <section class="contact-section" aria-labelledby="openings-title">
    <div class="section-heading">
      <p class="eyebrow" id="openings-title">Openings</p>
    </div>
    <div class="panel openings-panel">
      <h2>{openingsTitle}</h2>
      {openingsParagraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </section>

  <section class="contact-section" aria-labelledby="contact-title">
    <div class="section-heading">
      <p class="eyebrow" id="contact-title">Contact</p>
    </div>
    <div class="panel contact-panel">
      <div class="contact-intro">
        <p class="tagline">{contactText}</p>
      </div>
      <dl class="contact-list">
        <div>
          <dt>Email</dt>
          <dd><a href="mailto:jacob.pettine@stonybrook.edu">jacob.pettine@stonybrook.edu</a></dd>
        </div>
        <div>
          <dt>Location</dt>
          <dd>{addressLines.map((line) => <>{line}<br /></>)}</dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="contact-section" aria-labelledby="find-us-title">
    <div class="section-heading">
      <p class="eyebrow" id="find-us-title">Find us</p>
    </div>
    <div class="panel map-panel">
      <iframe
        title="Google Map showing the Department of Physics and Astronomy at Stony Brook University"
        src="https://www.google.com/maps?q=Department%20of%20Physics%20and%20Astronomy%2C%20Stony%20Brook%20University%2C%20Stony%20Brook%2C%20NY%2011790&output=embed"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allowfullscreen>
      </iframe>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-section {
    display: grid;
    gap: 1.5rem;
  }

  .section-heading {
    max-width: 760px;
  }

  .openings-panel,
  .contact-panel {
    display: grid;
    gap: 1.5rem;
  }

  .openings-panel p:last-child {
    margin-bottom: 0;
  }

  .contact-panel {
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.75fr);
    align-items: center;
  }

  .contact-intro p {
    margin-bottom: 0;
    color: var(--muted);
    font-size: clamp(1.1rem, 3vw, 1.5rem);
    line-height: 1.7;
  }

  .contact-list {
    display: grid;
    gap: 1rem;
    margin: 0;
  }

  .contact-list div {
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line);
  }

  .contact-list div:last-child {
    padding-bottom: 0;
    border-bottom: 0;
  }

  .contact-list dt {
    color: var(--accent);
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .contact-list dd {
    margin: 0.25rem 0 0;
    color: var(--text);
    line-height: 1.55;
  }

  .contact-list a {
    color: var(--accent-deep);
    font-weight: 800;
    text-decoration-color: rgb(181 22 31 / 28%);
    text-underline-offset: 0.2em;
  }

  .map-panel {
    overflow: hidden;
    padding: 0;
  }

  .map-panel iframe {
    display: block;
    width: 100%;
    min-height: min(70vh, 480px);
    border: 0;
  }

  @media (max-width: 760px) {
    .contact-panel {
      grid-template-columns: 1fr;
    }
  }
</style>
