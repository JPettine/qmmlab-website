    .banner {
      min-height: auto;
      padding: 1.3rem;
    }

    .matter-graphic {
      min-height: 250px;
    }

    .acronym-cascade span:nth-child(2),
    .acronym-cascade span:nth-child(3) {
      transform: none;
    }
  }
</style>

<script>
  const newsBar = document.querySelector<HTMLElement>('.home-news-bar');
  const siteHeader = document.querySelector<HTMLElement>('.site-header');

  const updateNewsBarTop = () => {
    if (!newsBar || !siteHeader) return;

    const headerBottom = siteHeader.getBoundingClientRect().bottom;
    newsBar.style.setProperty('--home-news-bar-top', `${Math.max(0, headerBottom)}px`);
  };

  updateNewsBarTop();
  window.addEventListener('scroll', updateNewsBarTop, { passive: true });
  window.addEventListener('resize', updateNewsBarTop);
</script>


<script>
  const researchCarousels = document.querySelectorAll<HTMLElement>('[data-research-carousel]');

  researchCarousels.forEach((carousel) => {
    const windowEl = carousel.querySelector<HTMLElement>('.carousel-window');
    const track = carousel.querySelector<HTMLElement>('.carousel-track');
    const prev = carousel.querySelector<HTMLButtonElement>('[data-research-carousel-prev]');
    const next = carousel.querySelector<HTMLButtonElement>('[data-research-carousel-next]');

    if (!windowEl || !track || !prev || !next) return;

    let offset = 0;
    let lastTime = performance.now();
    let isPaused = false;
    const speed = 32;

    const getLoopWidth = () => track.scrollWidth / 3;
    const wrapOffset = () => {
      const loopWidth = getLoopWidth();
      if (loopWidth <= 0) return;
      offset = ((offset % loopWidth) + loopWidth) % loopWidth;
    };

    const render = () => {
      track.style.transform = `translateX(-${offset}px)`;
    };

    const step = (time: number) => {
      const elapsed = time - lastTime;
      lastTime = time;

      if (!isPaused && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        offset += (elapsed / 1000) * speed;
        wrapOffset();
        render();
      }

      requestAnimationFrame(step);
    };

    const move = (direction: 1 | -1) => {
      const slide = track.querySelector<HTMLElement>('.research-slide');
      const slideWidth = slide ? slide.offsetWidth + 16 : Math.min(380, windowEl.clientWidth * 0.8);
      offset += direction * slideWidth;
      wrapOffset();
      render();
    };

    carousel.addEventListener('mouseenter', () => { isPaused = true; });
    carousel.addEventListener('mouseleave', () => { isPaused = false; });
    carousel.addEventListener('focusin', () => { isPaused = true; });
    carousel.addEventListener('focusout', () => { isPaused = false; });
    window.addEventListener('resize', () => { wrapOffset(); render(); });

    prev.addEventListener('click', () => move(-1));
    next.addEventListener('click', () => move(1));

    requestAnimationFrame(step);
  });
</script>
