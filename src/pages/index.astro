---
const siteTitle = 'QMM Lab';
const tagline = 'Astro scaffolding for a modern research lab website.';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="QMM Lab website scaffold built with Astro."
    />
    <title>{siteTitle}</title>
  </head>
  <body>
    <main class="site-shell">
      <section class="hero" aria-labelledby="page-title">
        <p class="eyebrow">Research Lab Website</p>
        <h1 id="page-title">{siteTitle}</h1>
        <p class="tagline">{tagline}</p>
        <div class="actions" aria-label="Suggested next pages">
          <a href="#next-steps">Plan next steps</a>
          <a href="https://docs.astro.build" rel="noreferrer">Astro docs</a>
        </div>
      </section>

      <section id="next-steps" class="panel" aria-labelledby="next-steps-title">
        <h2 id="next-steps-title">Recommended next content sections</h2>
        <ul>
          <li>People, principal investigators, students, and alumni</li>
          <li>Research areas, projects, publications, and news</li>
          <li>Contact details, recruiting information, and lab resources</li>
        </ul>
      </section>
    </main>
  </body>
</html>

<style>
  :root {
    color-scheme: light;
    --accent: #4158d0;
    --accent-dark: #1f2f80;
    --surface: #ffffff;
    --text: #172033;
    --muted: #5f6b7a;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
      "Segoe UI", sans-serif;
  }

  body {
    margin: 0;
    min-height: 100vh;
    background:
      radial-gradient(circle at top left, rgb(65 88 208 / 18%), transparent 32rem),
      linear-gradient(135deg, #f7f9ff 0%, #eef4ff 100%);
    color: var(--text);
  }

  .site-shell {
    display: grid;
    gap: 2rem;
    margin: 0 auto;
    max-width: 960px;
    padding: 6rem 1.5rem;
  }

  .hero,
  .panel {
    border: 1px solid rgb(23 32 51 / 10%);
    border-radius: 28px;
    background: rgb(255 255 255 / 78%);
    box-shadow: 0 24px 80px rgb(31 47 128 / 14%);
    backdrop-filter: blur(18px);
  }

  .hero {
    padding: clamp(2rem, 7vw, 5rem);
  }

  .eyebrow {
    margin: 0 0 1rem;
    color: var(--accent-dark);
    font-size: 0.83rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  h1,
  h2,
  p {
    margin-top: 0;
  }

  h1 {
    margin-bottom: 1rem;
    font-size: clamp(3rem, 10vw, 6.5rem);
    line-height: 0.95;
  }

  h2 {
    margin-bottom: 1rem;
    font-size: clamp(1.5rem, 4vw, 2.25rem);
  }

  .tagline {
    max-width: 40rem;
    color: var(--muted);
    font-size: clamp(1.1rem, 3vw, 1.5rem);
    line-height: 1.6;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 2rem;
  }

  .actions a {
    border-radius: 999px;
    padding: 0.85rem 1.2rem;
    background: var(--accent);
    color: white;
    font-weight: 700;
    text-decoration: none;
  }

  .actions a:last-child {
    background: transparent;
    color: var(--accent-dark);
    box-shadow: inset 0 0 0 1px rgb(31 47 128 / 24%);
  }

  .panel {
    padding: clamp(1.5rem, 5vw, 3rem);
  }

  .panel ul {
    margin: 0;
    padding-left: 1.25rem;
    color: var(--muted);
    line-height: 1.8;
  }
</style>
