    transform: translateY(-0.05em);
  }

  .research-carousel-arrow-left { left: 0.75rem; }
  .research-carousel-arrow-right { right: 0.75rem; }

  .research-carousel-shell:hover .research-carousel-arrow,
  .research-carousel-shell:focus-within .research-carousel-arrow {
    opacity: 1;
  }

