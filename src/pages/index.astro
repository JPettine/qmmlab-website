---
import { existsSync, readdirSync, readFileSync } from 'node:fs';
import { join, parse } from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';


const aboutPath = join(process.cwd(), 'public', 'home', 'about.txt');
const aboutContent = existsSync(aboutPath)
  ? readFileSync(aboutPath, 'utf8').trim()
  : '';
const [aboutTitle = 'A clean home for quantum meta-matter research', ...aboutParagraphs] = aboutContent
  .split(/\r?\n\r?\n/)
  .map((part) => part.trim())
  .filter(Boolean);


const highlightsDir = join(process.cwd(), 'public', 'highlights');
const imageExtensions = new Set(['.png', '.jpg', '.jpeg', '.webp', '.avif', '.gif', '.svg']);
const highlightImagePattern = /^highlight(\d+)_(.+)\.([^.]+)$/i;
const highlightLinkPattern = /^(https?:\/\/\S+|\/\S*)$/i;
const highlightSlides = existsSync(highlightsDir)
  ? readdirSync(highlightsDir)
      .map((fileName) => {
        const match = fileName.match(highlightImagePattern);
        if (!match || !imageExtensions.has(`.${match[3].toLowerCase()}`)) return null;

        const slideNumber = match[1];
        const label = match[2];
        const textPath = join(highlightsDir, `highlight${slideNumber}_${label}.txt`);
        const textBlocks = existsSync(textPath)
          ? readFileSync(textPath, 'utf8').trim().split(/\r?\n\r?\n/).map((part) => part.trim()).filter(Boolean)
          : [];
        const possibleLink = textBlocks.at(-1) ?? '';
        const href = highlightLinkPattern.test(possibleLink) ? possibleLink : '';
        const displayBlocks = href ? textBlocks.slice(0, -1) : textBlocks;
        const [summary = `Research highlight ${slideNumber}`, ...bodyParts] = displayBlocks;

        return {
          number: Number(slideNumber),
          image: `/highlights/${fileName}`,
          summary,
          description: bodyParts.join(' '),
          href,
        };
      })
      .filter((slide): slide is { number: number; image: string; summary: string; description: string; href: string } => Boolean(slide))
      .sort((a, b) => a.number - b.number)
  : [];


const newsDir = join(process.cwd(), 'public', 'news');
const newsItems = existsSync(newsDir)
  ? readdirSync(newsDir)
      .filter((fileName) => fileName.toLowerCase().endsWith('.txt'))
      .map((fileName) => {
        const lines = readFileSync(join(newsDir, fileName), 'utf8')
          .split(/\r?\n/)
          .map((line) => line.trim())
          .filter(Boolean);

        return {
          id: parse(fileName).name,
          snippet: lines[0] ?? '',
        };
      })
      .filter((item) => item.snippet)
      .sort((a, b) => b.id.localeCompare(a.id))
  : [];

const researchDir = join(process.cwd(), 'public', 'research');
const snapshotsDir = join(process.cwd(), 'public', 'home', 'snapshots');
const snapshotPattern = /^(questions|approaches)(\d+)_snapshot_(.+)\.([^.]+)$/i;
const snapshotFiles = existsSync(snapshotsDir) ? readdirSync(snapshotsDir) : [];
const researchFiles = existsSync(researchDir) ? readdirSync(researchDir) : [];
const snapshotPlaceholders = researchFiles
  .map((fileName) => {
    const match = fileName.match(/^(questions|approaches)(\d+)_(.+)\.txt$/i);
    if (!match) return null;
    const section = match[1].toLowerCase();
    const number = Number(match[2]);
    const title = readFileSync(join(researchDir, fileName), 'utf8').trim().split(/\r?\n\r?\n/)[0]?.trim()
      || (section === 'questions' ? `Research question ${number}` : `Experimental approach ${number}`);
    return { section, number, title, image: '' };
  })
  .filter((slide): slide is { section: string; number: number; title: string; image: string } => Boolean(slide));
const snapshotImages = snapshotFiles
  .map((fileName) => {
    const match = fileName.match(snapshotPattern);
    if (!match || !imageExtensions.has(`.${match[4].toLowerCase()}`)) return null;
    const section = match[1].toLowerCase();
    const number = Number(match[2]);
    return {
      section,
      number,
      title: section === 'questions' ? `Research question ${number}` : `Experimental approach ${number}`,
      image: `/home/snapshots/${fileName}`,
    };
  })
  .filter((slide): slide is { section: string; number: number; title: string; image: string } => Boolean(slide));
const researchSlides = (snapshotImages.length > 0 ? snapshotImages : snapshotPlaceholders)
  .map((slide) => ({
    ...slide,
    caption: slide.image ? 'Research snapshot' : 'Snapshot image coming soon',
    href: `/research/#${slide.section}${slide.number}`,
    randomKey: Math.random(),
  }))
  .sort((a, b) => a.randomKey - b.randomKey);
---

<BaseLayout title="QMM Lab" description="Quantum Meta-Matter research group website.">


  {
    newsItems.length > 0 && (
      <aside class="home-news-bar" aria-labelledby="home-news-title">
        <p class="eyebrow" id="home-news-title">News</p>
        <div class="home-news-list">
          {newsItems.map((item) => (
            <article class="home-news-item">
              <p>{item.snippet}</p>
            </article>
          ))}
        </div>
        <a class="home-news-more" href="/news/">See more...</a>
      </aside>
    )
  }


  {
    highlightSlides.length > 0 && (
      <section class="highlight-section" aria-labelledby="highlights-title">
        <div class="section-heading">
          <p class="eyebrow" id="highlights-title">Highlights</p>
        </div>
        <div class="highlight-carousel" aria-label="Research highlights" data-highlight-carousel>
        <div class="highlight-track">
          {highlightSlides.map((slide) => (
            <figure class="highlight-slide">
              {slide.href ? (
                <a class="highlight-image-link" href={slide.href}>
                  <img src={slide.image} alt={slide.summary} loading="eager" />
                </a>
              ) : (
                <img src={slide.image} alt={slide.summary} loading="eager" />
              )}
              <figcaption class="highlight-caption">
                <strong>{slide.summary}</strong>
                {slide.description && <p>{slide.description}</p>}
              </figcaption>
            </figure>
          ))}
        </div>
        <div class="highlight-dots" aria-label="Highlight carousel position">
          {highlightSlides.map((slide, index) => (
            <button
              type="button"
              class:list={[index === 0 && 'is-active']}
              aria-label={`Show highlight ${slide.number}`}
              aria-current={index === 0 ? 'true' : 'false'}
              data-highlight-dot={index}
            />
          ))}
        </div>
        </div>
      </section>
    )
  }

  <section class="about-section" aria-labelledby="about-title">
    <div class="section-heading">
      <p class="eyebrow">About the group</p>
    </div>
    <div class="about-group">
      <h1 id="about-title">{aboutTitle}</h1>
      <div class="about-copy">
        {aboutParagraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
  </section>

  {
    researchSlides.length > 0 && (
      <section class="research-carousel" aria-labelledby="carousel-title">
        <div class="section-heading">
          <p class="eyebrow">Research snapshots</p>
        </div>

        <div class="research-carousel-shell" data-research-carousel>
          <button class="research-carousel-arrow research-carousel-arrow-left" type="button" aria-label="Previous research snapshot" data-research-carousel-prev><span aria-hidden="true">‹</span></button>
          <div class="carousel-window" aria-label="Scrolling research snapshots">
            <div class="carousel-track">
            {[...researchSlides, ...researchSlides, ...researchSlides].map((slide) => (
              <a class="research-slide" href={slide.href}>
                {slide.image ? (
                  <img class="snapshot-image" src={slide.image} alt={slide.title} loading="lazy" />
                ) : (
                  <div class="snapshot-placeholder" aria-hidden="true"></div>
                )}
                <div>
                  <h3>{slide.title}</h3>
                  <p>{slide.caption}</p>
                </div>
              </a>
            ))}
            </div>
          </div>
          <button class="research-carousel-arrow research-carousel-arrow-right" type="button" aria-label="Next research snapshot" data-research-carousel-next><span aria-hidden="true">›</span></button>
        </div>
      </section>
    )
  }

</BaseLayout>

<style>

  .home-news-bar {
    position: fixed;
    top: var(--home-news-bar-top, 3.2rem);
    bottom: 0;
    left: 0;
    z-index: 8;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    gap: 0.85rem;
    width: 15vw;
    overflow: hidden;
    padding: 1rem;
    border: 1px solid var(--line);
    border-radius: 0 22px 0 0;
    background: rgb(255 255 255 / 94%);
    box-shadow: var(--shadow);
  }

  .home-news-list {
    display: grid;
    align-content: start;
    gap: 0.75rem;
    overflow: hidden;
  }

  .home-news-item {
    border-bottom: 1px solid var(--line);
    padding-bottom: 0.75rem;
  }

  .home-news-item p {
    margin: 0;
    color: var(--muted);
    font-size: 0.82rem;
    line-height: 1.45;
  }

