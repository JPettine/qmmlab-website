---
import BaseLayout from '../layouts/BaseLayout.astro';

const researchSlides = [
  {
    title: 'Programmable quantum lattices',
    caption: 'Dummy image placeholder for tunable quantum materials and lattice-scale control.',
    pattern: 'lattice',
  },
  {
    title: 'Metasurface modes',
    caption: 'Dummy image placeholder for structured meta-matter and optical responses.',
    pattern: 'waves',
  },
  {
    title: 'Correlated phases',
    caption: 'Dummy image placeholder for emergent collective behavior in quantum matter.',
    pattern: 'nodes',
  },
  {
    title: 'Quantum devices',
    caption: 'Dummy image placeholder for measurement platforms and hybrid device concepts.',
    pattern: 'device',
  },
  {
    title: 'Theory and design',
    caption: 'Dummy image placeholder for models, algorithms, and materials discovery.',
    pattern: 'orbitals',
  },
];
---

<BaseLayout title="QMM Lab" description="Quantum Meta-Matter research group website.">
  <section class="feature-carousel" aria-labelledby="carousel-title">
    <h1 id="carousel-title" class="visually-hidden">QMM Lab research highlights</h1>
    <div class="slide-stage" aria-label="Rotating research graphic placeholders">
      {researchSlides.map((slide, index) => (
        <article class={`feature-slide ${slide.pattern}`} style={`--slide-index: ${index};`}>
          <div class="dummy-art" aria-hidden="true">
            <span></span><span></span><span></span><span></span><span></span><span></span>
          </div>
          <div class="slide-copy">
            <p class="eyebrow">Research snapshot {index + 1}</p>
            <h2>{slide.title}</h2>
            <p>{slide.caption}</p>
          </div>
        </article>
      ))}
    </div>
    <div class="carousel-dots" aria-hidden="true">
      {researchSlides.map((_, index) => <span style={`--dot-index: ${index};`}></span>)}
    </div>
  </section>

  <section class="blurbs" aria-labelledby="about-title">
    <div class="section-heading compact">
      <p class="eyebrow">About the group</p>
      <h2 id="about-title">A clean home for quantum meta-matter research</h2>
    </div>
    <div class="blurb-grid">
      <article>
        <h3>What we study</h3>
        <p>QMM Lab explores quantum materials, engineered meta-structures, and the emergent matter phases that appear when geometry, interactions, and measurement meet.</p>
      </article>
      <article>
        <h3>How we work</h3>
        <p>The group combines theory, design, computation, and experiment-facing collaboration to build intuition across scales and identify testable signatures.</p>
      </article>
      <article>
        <h3>Who should connect</h3>
        <p>Students, researchers, and collaborators interested in quantum materials, metamaterials, condensed matter, and device-oriented discovery are encouraged to reach out.</p>
      </article>
    </div>
  </section>

  <section class="logistics" aria-labelledby="logistics-title">
    <div>
      <p class="eyebrow">Logistics</p>
      <h2 id="logistics-title">Contact and visit information</h2>
      <p class="lede">Replace these placeholders with the lab's official address, email, office location, and institutional links.</p>
    </div>
    <dl class="contact-list">
      <div>
        <dt>Email</dt>
        <dd><a href="mailto:contact@qmmlab.example">contact@qmmlab.example</a></dd>
      </div>
      <div>
        <dt>Location</dt>
        <dd>University campus building and room number TBD</dd>
      </div>
      <div>
        <dt>Openings</dt>
        <dd><a href="/openings/">Prospective students and postdocs can check the openings page.</a></dd>
      </div>
    </dl>
  </section>
</BaseLayout>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .feature-carousel {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .slide-stage {
    position: relative;
    min-height: clamp(390px, 66vh, 650px);
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: #f5f5f5;
    box-shadow: var(--shadow);
  }

  .feature-slide {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(300px, 0.65fr);
    align-items: stretch;
    gap: 0;
    opacity: 0;
    animation: rotate-slide 25s infinite;
    animation-delay: calc(var(--slide-index) * 5s);
  }

  .dummy-art {
    position: relative;
    min-width: 0;
    min-height: 100%;
    overflow: hidden;
    background:
      linear-gradient(135deg, rgb(181 22 31 / 14%), rgb(255 255 255 / 12%)),
      radial-gradient(circle at 20% 20%, rgb(255 255 255 / 92%), transparent 25%),
      radial-gradient(circle at 72% 68%, rgb(181 22 31 / 32%), transparent 35%),
      #f7f7f7;
  }

  .dummy-art::before,
  .dummy-art::after {
    position: absolute;
    inset: 0;
    content: '';
  }

  .dummy-art::before {
    background-image:
      linear-gradient(rgb(181 22 31 / 15%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(181 22 31 / 15%) 1px, transparent 1px);
    background-size: 46px 46px;
    mask-image: linear-gradient(90deg, #000, transparent 90%);
  }

  .dummy-art::after {
    background: linear-gradient(90deg, transparent 58%, rgb(255 255 255 / 70%));
  }

  .dummy-art span {
    position: absolute;
    z-index: 1;
    display: block;
    border: 2px solid rgb(181 22 31 / 55%);
    border-radius: 999px;
  }

  .lattice .dummy-art span {
    width: clamp(42px, 7vw, 82px);
    height: clamp(42px, 7vw, 82px);
    background: rgb(255 255 255 / 35%);
  }

  .lattice .dummy-art span:nth-child(1) { left: 10%; top: 18%; }
  .lattice .dummy-art span:nth-child(2) { left: 35%; top: 13%; }
  .lattice .dummy-art span:nth-child(3) { left: 62%; top: 27%; }
  .lattice .dummy-art span:nth-child(4) { left: 20%; top: 57%; }
  .lattice .dummy-art span:nth-child(5) { left: 48%; top: 68%; }
  .lattice .dummy-art span:nth-child(6) { left: 76%; top: 58%; }

  .waves .dummy-art span {
    left: -8%;
    width: 116%;
    height: 18%;
    border-color: transparent transparent rgb(181 22 31 / 56%) transparent;
  }

  .waves .dummy-art span:nth-child(1) { top: 5%; }
  .waves .dummy-art span:nth-child(2) { top: 19%; }
  .waves .dummy-art span:nth-child(3) { top: 33%; }
  .waves .dummy-art span:nth-child(4) { top: 47%; }
  .waves .dummy-art span:nth-child(5) { top: 61%; }
  .waves .dummy-art span:nth-child(6) { top: 75%; }

  .nodes .dummy-art span {
    width: clamp(24px, 4vw, 44px);
    height: clamp(24px, 4vw, 44px);
    background: rgb(181 22 31 / 14%);
    box-shadow: 0 0 0 clamp(16px, 3vw, 34px) rgb(181 22 31 / 4%);
  }

  .nodes .dummy-art span:nth-child(1) { left: 15%; top: 23%; }
  .nodes .dummy-art span:nth-child(2) { left: 44%; top: 14%; }
  .nodes .dummy-art span:nth-child(3) { left: 70%; top: 34%; }
  .nodes .dummy-art span:nth-child(4) { left: 28%; top: 63%; }
  .nodes .dummy-art span:nth-child(5) { left: 56%; top: 73%; }
  .nodes .dummy-art span:nth-child(6) { left: 82%; top: 65%; }

  .device .dummy-art span {
    border-radius: 4px;
  }

  .device .dummy-art span:nth-child(1) { inset: 18% 16%; }
  .device .dummy-art span:nth-child(2) { left: 16%; top: 48%; width: 68%; height: 1px; }
  .device .dummy-art span:nth-child(3) { left: 48%; top: 16%; width: 1px; height: 68%; }
  .device .dummy-art span:nth-child(4) { left: 24%; top: 24%; width: 76px; height: 76px; }
  .device .dummy-art span:nth-child(5) { right: 24%; bottom: 24%; width: 76px; height: 76px; }
  .device .dummy-art span:nth-child(6) { left: 42%; top: 39%; width: 90px; height: 90px; }

  .orbitals .dummy-art span {
    left: 50%;
    top: 50%;
    width: min(70%, 520px);
    height: min(24%, 170px);
    transform: translate(-50%, -50%) rotate(var(--turn));
  }

  .orbitals .dummy-art span:nth-child(1) { --turn: 0deg; }
  .orbitals .dummy-art span:nth-child(2) { --turn: 30deg; }
  .orbitals .dummy-art span:nth-child(3) { --turn: 60deg; }
  .orbitals .dummy-art span:nth-child(4) { --turn: 90deg; }
  .orbitals .dummy-art span:nth-child(5) { --turn: 120deg; }
  .orbitals .dummy-art span:nth-child(6) { --turn: 150deg; }

  .slide-copy {
    position: relative;
    z-index: 2;
    display: grid;
    align-content: end;
    padding: clamp(1.5rem, 4vw, 3rem);
    background: linear-gradient(90deg, rgb(255 255 255 / 74%), #ffffff 28%);
  }

  .slide-copy h2 {
    max-width: 11ch;
    margin-bottom: 0.85rem;
    color: var(--text);
  }

  .slide-copy p:last-child {
    margin-bottom: 0;
    color: var(--muted);
    font-size: clamp(1rem, 1.7vw, 1.22rem);
    line-height: 1.6;
  }

  .carousel-dots {
    position: absolute;
    z-index: 4;
    right: clamp(1rem, 3vw, 2rem);
    bottom: clamp(1rem, 3vw, 2rem);
    display: flex;
    gap: 0.55rem;
  }

  .carousel-dots span {
    width: 0.72rem;
    height: 0.72rem;
    border: 1px solid rgb(255 255 255 / 88%);
    border-radius: 50%;
    background: rgb(185 185 185 / 80%);
    box-shadow: 0 0 0 1px rgb(0 0 0 / 8%);
    animation: rotate-dot 25s infinite;
    animation-delay: calc(var(--dot-index) * 5s);
  }

  .blurbs,
  .logistics {
    display: grid;
    gap: 1.5rem;
  }

  .section-heading.compact {
    max-width: 680px;
  }

  .blurb-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .blurb-grid article,
  .logistics {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: #ffffff;
    box-shadow: var(--shadow);
  }

  .blurb-grid article {
    padding: clamp(1.3rem, 3vw, 2rem);
  }

  .blurb-grid p {
    margin-bottom: 0;
    color: var(--muted);
    line-height: 1.7;
  }

  .logistics {
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    align-items: start;
    padding: clamp(1.5rem, 5vw, 3rem);
    background:
      linear-gradient(135deg, rgb(181 22 31 / 6%), transparent 38%),
      #ffffff;
  }

  .contact-list {
    display: grid;
    gap: 1rem;
    min-width: 0;
    margin: 0;
  }

  .contact-list div {
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line);
  }

  .contact-list div:last-child {
    padding-bottom: 0;
    border-bottom: 0;
  }

  .contact-list dt {
    color: var(--accent);
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .contact-list dd {
    margin: 0.25rem 0 0;
    color: var(--muted);
    line-height: 1.55;
  }

  .contact-list a {
    color: var(--accent-deep);
    font-weight: 800;
    overflow-wrap: anywhere;
    text-decoration-color: rgb(181 22 31 / 28%);
    text-underline-offset: 0.2em;
  }

  @keyframes rotate-slide {
    0%, 16% {
      opacity: 1;
      z-index: 2;
    }
    20%, 96% {
      opacity: 0;
      z-index: 1;
    }
    100% {
      opacity: 1;
      z-index: 2;
    }
  }

  @keyframes rotate-dot {
    0%, 16% {
      background: #ffffff;
      transform: scale(1.16);
    }
    20%, 96% {
      background: rgb(185 185 185 / 80%);
      transform: scale(1);
    }
    100% {
      background: #ffffff;
      transform: scale(1.16);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .feature-slide,
    .carousel-dots span {
      animation: none;
    }

    .feature-slide:first-child {
      opacity: 1;
      z-index: 2;
    }

    .carousel-dots span:first-child {
      background: #ffffff;
      transform: scale(1.16);
    }
  }

  @media (max-width: 900px) {
    .feature-slide,
    .logistics {
      grid-template-columns: 1fr;
    }

    .slide-stage {
      min-height: 640px;
    }

    .dummy-art {
      min-height: 360px;
    }

    .slide-copy {
      align-content: start;
      background: #ffffff;
    }

    .blurb-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .slide-stage {
      min-height: 580px;
    }

    .dummy-art {
      min-height: 300px;
    }

    .carousel-dots {
      right: 1rem;
      bottom: 1rem;
    }
  }
</style>
