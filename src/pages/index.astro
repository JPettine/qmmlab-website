---
import BaseLayout from '../layouts/BaseLayout.astro';

const researchSlides = [
  {
    title: 'Programmable lattices',
    caption: 'Dummy graphic placeholder for tunable quantum materials.',
    pattern: 'lattice',
  },
  {
    title: 'Metasurface modes',
    caption: 'Dummy graphic placeholder for patterned meta-matter.',
    pattern: 'waves',
  },
  {
    title: 'Correlated phases',
    caption: 'Dummy graphic placeholder for emergent collective behavior.',
    pattern: 'nodes',
  },
  {
    title: 'Quantum devices',
    caption: 'Dummy graphic placeholder for measurement platforms.',
    pattern: 'device',
  },
  {
    title: 'Theory + design',
    caption: 'Dummy graphic placeholder for models, algorithms, and discovery.',
    pattern: 'orbitals',
  },
];
---

<BaseLayout title="QMM Lab" description="Quantum Meta-Matter research group website.">
  <section class="banner" aria-labelledby="page-title">
    <div class="banner-copy">
      <p class="eyebrow">Quantum Meta-Matter</p>
      <h1 id="page-title">QMM Lab</h1>
      <div class="acronym-cascade" aria-label="QMM acronym expanded as quantum, meta, matter">
        <span><strong>Q</strong>uantum</span>
        <span><strong>M</strong>eta</span>
        <span><strong>M</strong>atter</span>
      </div>
    </div>

    <div class="matter-graphic" aria-label="Stylized red-on-white quantum meta-matter graphic" role="img">
      <svg viewBox="0 0 420 320" aria-hidden="true">
        <defs>
          <radialGradient id="node-fill" cx="35%" cy="30%" r="75%">
            <stop offset="0%" stop-color="#fffbfb" />
            <stop offset="100%" stop-color="#b5161f" />
          </radialGradient>
          <filter id="soft-glow" x="-30%" y="-30%" width="160%" height="160%">
            <feGaussianBlur stdDeviation="8" result="blur" />
            <feMerge>
              <feMergeNode in="blur" />
              <feMergeNode in="SourceGraphic" />
            </feMerge>
          </filter>
        </defs>
        <path class="field-line" d="M43 214 C105 76 214 277 379 80" />
        <path class="field-line thin" d="M33 118 C137 190 227 58 376 160" />
        <path class="field-line thin" d="M94 274 C148 138 267 209 341 38" />
        <g class="meta-grid">
          <path d="M96 82 L205 37 L319 92 L330 218 L216 283 L88 222 Z" />
          <path d="M96 82 L216 283 M205 37 L330 218 M319 92 L88 222" />
          <path d="M96 82 L330 218 M205 37 L88 222 M319 92 L216 283" />
        </g>
        <g filter="url(#soft-glow)">
          <circle cx="96" cy="82" r="13" />
          <circle cx="205" cy="37" r="10" />
          <circle cx="319" cy="92" r="15" />
          <circle cx="330" cy="218" r="11" />
          <circle cx="216" cy="283" r="14" />
          <circle cx="88" cy="222" r="10" />
          <circle cx="210" cy="160" r="20" />
        </g>
        <ellipse class="orbit" cx="210" cy="160" rx="148" ry="54" />
        <ellipse class="orbit tilt" cx="210" cy="160" rx="148" ry="54" />
      </svg>
    </div>
  </section>

  <section class="research-carousel" aria-labelledby="carousel-title">
    <div class="section-heading">
      <p class="eyebrow">Research snapshots</p>
      <h2 id="carousel-title">Five placeholder graphics for future lab images</h2>
      <p class="lede">These dummy panels are ready to be replaced with uploaded research graphics while preserving the clean scrolling layout.</p>
    </div>

    <div class="carousel-window" aria-label="Scrolling research graphic placeholders">
      <div class="carousel-track">
        {[...researchSlides, ...researchSlides].map((slide) => (
          <article class={`research-slide ${slide.pattern}`}>
            <div class="dummy-art" aria-hidden="true">
              <span></span><span></span><span></span><span></span><span></span>
            </div>
            <div>
              <h3>{slide.title}</h3>
              <p>{slide.caption}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="blurbs" aria-labelledby="about-title">
    <div class="section-heading compact">
      <p class="eyebrow">About the group</p>
      <h2 id="about-title">A clean home for quantum meta-matter research</h2>
    </div>
    <div class="blurb-grid">
      <article>
        <h3>What we study</h3>
        <p>QMM Lab explores quantum materials, engineered meta-structures, and the emergent matter phases that appear when geometry, interactions, and measurement meet.</p>
      </article>
      <article>
        <h3>How we work</h3>
        <p>The group combines theory, design, computation, and experiment-facing collaboration to build intuition across scales and identify testable signatures.</p>
      </article>
      <article>
        <h3>Who should connect</h3>
        <p>Students, researchers, and collaborators interested in quantum materials, metamaterials, condensed matter, and device-oriented discovery are encouraged to reach out.</p>
      </article>
    </div>
  </section>

  <section class="logistics" aria-labelledby="logistics-title">
    <div>
      <p class="eyebrow">Logistics</p>
      <h2 id="logistics-title">Contact and visit information</h2>
      <p class="lede">Replace these placeholders with the lab's official address, email, office location, and institutional links.</p>
    </div>
    <dl class="contact-list">
      <div>
        <dt>Email</dt>
        <dd><a href="mailto:contact@qmmlab.example">contact@qmmlab.example</a></dd>
      </div>
      <div>
        <dt>Location</dt>
        <dd>University campus building and room number TBD</dd>
      </div>
      <div>
        <dt>Openings</dt>
        <dd><a href="/openings/">Prospective students and postdocs can check the openings page.</a></dd>
      </div>
    </dl>
  </section>
</BaseLayout>

<style>
  .banner {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(320px, 0.95fr);
    align-items: center;
    gap: clamp(2rem, 6vw, 5rem);
    min-height: clamp(420px, 65vh, 680px);
    padding: clamp(2rem, 7vw, 5.5rem);
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 36px;
    background:
      linear-gradient(135deg, rgb(255 255 255 / 96%), rgb(255 250 250 / 90%)),
      radial-gradient(circle at 86% 14%, rgb(181 22 31 / 18%), transparent 26rem);
    box-shadow: var(--shadow);
  }

  .banner-copy {
    position: relative;
    z-index: 1;
  }

  .banner h1 {
    margin: 0;
    color: var(--accent);
    font-size: clamp(5rem, 16vw, 12rem);
    letter-spacing: -0.12em;
    text-transform: uppercase;
  }

  .acronym-cascade {
    display: grid;
    gap: 0.28rem;
    margin-top: 0.5rem;
    color: var(--accent-deep);
    font-size: clamp(1.35rem, 4vw, 2.6rem);
    font-weight: 300;
    letter-spacing: -0.035em;
  }

  .acronym-cascade span {
    display: block;
  }

  .acronym-cascade span:nth-child(2) {
    transform: translateX(clamp(2rem, 7vw, 5.5rem));
  }

  .acronym-cascade span:nth-child(3) {
    transform: translateX(clamp(4rem, 14vw, 11rem));
  }

  .acronym-cascade strong {
    color: var(--accent);
    font-weight: 950;
  }

  .matter-graphic {
    position: relative;
    display: grid;
    min-height: 320px;
    place-items: center;
    border-radius: 999px;
    background:
      radial-gradient(circle, rgb(255 255 255 / 100%) 0 42%, rgb(255 241 242 / 70%) 43% 58%, transparent 59%),
      repeating-radial-gradient(circle, rgb(181 22 31 / 12%) 0 1px, transparent 1px 28px);
  }

  .matter-graphic svg {
    width: min(100%, 460px);
    color: var(--accent);
  }

  .matter-graphic circle {
    fill: url(#node-fill);
  }

  .field-line,
  .orbit,
  .meta-grid path {
    fill: none;
    stroke: currentColor;
  }

  .field-line {
    stroke-width: 7;
    stroke-linecap: round;
    opacity: 0.22;
  }

  .field-line.thin {
    stroke-width: 3;
    opacity: 0.28;
  }

  .meta-grid path {
    stroke-width: 2;
    opacity: 0.45;
  }

  .orbit {
    stroke-width: 2;
    opacity: 0.5;
    transform-origin: 210px 160px;
  }

  .orbit.tilt {
    transform: rotate(62deg);
  }

  .section-heading {
    max-width: 760px;
  }

  .section-heading.compact {
    max-width: 680px;
  }

  .carousel-window {
    margin-top: 1.5rem;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 30px;
    background: linear-gradient(180deg, #ffffff, #fffafa);
  }

  .carousel-track {
    display: flex;
    width: max-content;
    animation: scroll-research 38s linear infinite;
  }

  .carousel-window:hover .carousel-track {
    animation-play-state: paused;
  }

  .research-slide {
    display: grid;
    grid-template-rows: 230px auto;
    gap: 1rem;
    width: min(74vw, 360px);
    min-height: 420px;
    margin: 1rem 0 1rem 1rem;
    padding: 1rem;
    border: 1px solid rgb(181 22 31 / 12%);
    border-radius: 24px;
    background: #ffffff;
  }

  .research-slide:last-child {
    margin-right: 1rem;
  }

  .research-slide h3 {
    margin-bottom: 0.35rem;
  }

  .research-slide p {
    margin-bottom: 0;
    color: var(--muted);
    line-height: 1.55;
  }

  .dummy-art {
    position: relative;
    overflow: hidden;
    border-radius: 18px;
    background:
      linear-gradient(135deg, rgb(181 22 31 / 8%), transparent),
      radial-gradient(circle at 20% 20%, rgb(181 22 31 / 18%), transparent 28%),
      #fffdfd;
  }

  .dummy-art span {
    position: absolute;
    display: block;
    border: 2px solid rgb(181 22 31 / 54%);
    border-radius: 999px;
  }

  .lattice .dummy-art span {
    width: 46px;
    height: 46px;
  }

  .lattice .dummy-art span:nth-child(1) { left: 12%; top: 18%; }
  .lattice .dummy-art span:nth-child(2) { left: 42%; top: 20%; }
  .lattice .dummy-art span:nth-child(3) { left: 68%; top: 45%; }
  .lattice .dummy-art span:nth-child(4) { left: 24%; top: 62%; }
  .lattice .dummy-art span:nth-child(5) { left: 54%; top: 72%; }

  .waves .dummy-art span {
    left: -12%;
    width: 124%;
    height: 76px;
    border-color: transparent transparent rgb(181 22 31 / 58%) transparent;
  }

  .waves .dummy-art span:nth-child(1) { top: 8%; }
  .waves .dummy-art span:nth-child(2) { top: 23%; }
  .waves .dummy-art span:nth-child(3) { top: 38%; }
  .waves .dummy-art span:nth-child(4) { top: 53%; }
  .waves .dummy-art span:nth-child(5) { top: 68%; }

  .nodes .dummy-art span {
    width: 26px;
    height: 26px;
    background: rgb(181 22 31 / 12%);
    box-shadow: 0 0 0 18px rgb(181 22 31 / 4%);
  }

  .nodes .dummy-art span:nth-child(1) { left: 18%; top: 28%; }
  .nodes .dummy-art span:nth-child(2) { left: 44%; top: 16%; }
  .nodes .dummy-art span:nth-child(3) { left: 70%; top: 35%; }
  .nodes .dummy-art span:nth-child(4) { left: 34%; top: 66%; }
  .nodes .dummy-art span:nth-child(5) { left: 62%; top: 72%; }

  .device .dummy-art span {
    border-radius: 8px;
  }

  .device .dummy-art span:nth-child(1) { inset: 18% 18%; }
  .device .dummy-art span:nth-child(2) { left: 16%; top: 48%; width: 68%; height: 1px; }
  .device .dummy-art span:nth-child(3) { left: 48%; top: 16%; width: 1px; height: 68%; }
  .device .dummy-art span:nth-child(4) { left: 24%; top: 24%; width: 52px; height: 52px; }
  .device .dummy-art span:nth-child(5) { right: 24%; bottom: 24%; width: 52px; height: 52px; }

  .orbitals .dummy-art span {
    left: 50%;
    top: 50%;
    width: 72%;
    height: 26%;
    transform: translate(-50%, -50%) rotate(var(--turn));
  }

  .orbitals .dummy-art span:nth-child(1) { --turn: 0deg; }
  .orbitals .dummy-art span:nth-child(2) { --turn: 36deg; }
  .orbitals .dummy-art span:nth-child(3) { --turn: 72deg; }
  .orbitals .dummy-art span:nth-child(4) { --turn: 108deg; }
  .orbitals .dummy-art span:nth-child(5) { --turn: 144deg; }

  .blurbs,
  .logistics {
    display: grid;
    gap: 1.5rem;
  }

  .blurb-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .blurb-grid article,
  .logistics {
    border: 1px solid var(--line);
    border-radius: 28px;
    background: #ffffff;
    box-shadow: var(--shadow);
  }

  .blurb-grid article {
    padding: clamp(1.3rem, 3vw, 2rem);
  }

  .blurb-grid p {
    margin-bottom: 0;
    color: var(--muted);
    line-height: 1.7;
  }

  .logistics {
    grid-template-columns: 0.9fr 1.1fr;
    align-items: start;
    padding: clamp(1.5rem, 5vw, 3rem);
    background:
      linear-gradient(135deg, rgb(181 22 31 / 6%), transparent 38%),
      #ffffff;
  }

  .contact-list {
    display: grid;
    gap: 1rem;
    margin: 0;
  }

  .contact-list div {
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line);
  }

  .contact-list div:last-child {
    padding-bottom: 0;
    border-bottom: 0;
  }

  .contact-list dt {
    color: var(--accent);
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .contact-list dd {
    margin: 0.25rem 0 0;
    color: var(--muted);
    line-height: 1.55;
  }

  .contact-list a {
    color: var(--accent-deep);
    font-weight: 800;
    text-decoration-color: rgb(181 22 31 / 28%);
    text-underline-offset: 0.2em;
  }

  @keyframes scroll-research {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .carousel-track {
      animation: none;
    }

    .carousel-window {
      overflow-x: auto;
    }
  }

  @media (max-width: 900px) {
    .banner,
    .logistics {
      grid-template-columns: 1fr;
    }

    .blurb-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .banner {
      min-height: auto;
      padding: 1.3rem;
    }

    .matter-graphic {
      min-height: 250px;
    }

    .acronym-cascade span:nth-child(2),
    .acronym-cascade span:nth-child(3) {
      transform: none;
    }
  }
</style>
