    display: flex;
    width: max-content;
  }

  .research-slide {
    display: grid;
    grid-template-rows: 230px auto;
    gap: 1rem;
    width: min(74vw, 360px);
    min-height: 420px;
    margin: 1rem 0 1rem 1rem;
