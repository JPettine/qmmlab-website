    width: 2.75rem;
    height: 2.75rem;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 1px solid rgb(181 22 31 / 20%);
    border-radius: 999px;
    background: rgb(255 255 255 / 92%);
