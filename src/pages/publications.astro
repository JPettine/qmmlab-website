---

<BaseLayout title="Publications | QMM Lab" description="Publications from QMM Lab.">
  <section class="publications-section" aria-labelledby="publication-list-title">
    <div class="section-heading">
      <p class="eyebrow" id="publication-list-title">Publication list</p>
    </div>
    <div class="panel publications-panel">
      <ul class="publication-list">
      {publications.map((publication) => (
        <li class="publication-item">
          <a class="publication-title" href={publication.link} target="_blank" rel="noreferrer">
            {publication.title}
          </a>
          <p class="publication-authors">{publication.authors}</p>
          <p class="publication-meta">
            <span>{publication.venue}</span>
            <span>{publication.year}</span>
          </p>
        </li>
      ))}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .publications-section { display: grid; gap: 1.5rem; }
  .publications-panel { display: grid; gap: 1.5rem; }
  .section-heading { max-width: 48rem; }
  .publication-list { display: grid; gap: 1rem; margin: 0; padding: 0; list-style: none; }
  .publication-item { padding: 1.2rem; border: 1px solid var(--line); border-radius: 22px; background: linear-gradient(135deg, var(--surface-warm), var(--surface)); }
  .publication-title { display: inline-block; margin-bottom: 0.55rem; color: var(--accent-deep); font-size: 1.08rem; font-weight: 850; line-height: 1.35; text-decoration-thickness: 0.08em; text-underline-offset: 0.2em; }
  .publication-authors { margin-bottom: 0.7rem; color: var(--muted); font-size: 1rem; line-height: 1.65; }
  .publication-meta { display: flex; flex-wrap: wrap; gap: 0.45rem; margin-bottom: 0; }
  .publication-meta span { border-radius: 999px; padding: 0.25rem 0.65rem; background: var(--accent-soft); color: var(--accent-deep); font-size: 0.82rem; font-weight: 800; }
</style>
