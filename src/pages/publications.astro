---

<BaseLayout title="Publications | QMM Lab" description="Publications from QMM Lab.">
  <section class="hero">
    <p class="eyebrow">Publications</p>
    <h1>Publications</h1>
    <p class="tagline">Selected peer-reviewed publications from Jacob Pettine's Google Scholar profile with nonzero citation counts.</p>
  </section>
  <section class="panel publications-panel">
    <div class="section-heading">
      <h2>Publication list</h2>
      <p class="lede">14 Google Scholar-indexed publications with nonzero “Cited by” values.</p>
    </div>
    <ol class="publication-list">
      {publications.map((publication) => (
        <li class="publication-item">
          <a class="publication-title" href={publication.link} target="_blank" rel="noreferrer">
            {publication.title}
          </a>
          <p class="publication-authors">{publication.authors}</p>
          <p class="publication-meta">
            <span>{publication.venue}</span>
            <span>{publication.year}</span>
          </p>
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>

<style>
  .publications-panel { display: grid; gap: 1.5rem; }
  .section-heading { max-width: 48rem; }
  .publication-list { display: grid; gap: 1rem; margin: 0; padding: 0; list-style: none; counter-reset: publications; }
  .publication-item { counter-increment: publications; position: relative; padding: 1.2rem 1.2rem 1.2rem 4rem; border: 1px solid var(--line); border-radius: 22px; background: linear-gradient(135deg, var(--surface-warm), var(--surface)); }
  .publication-item::before { content: counter(publications, decimal-leading-zero); position: absolute; left: 1.2rem; top: 1.2rem; color: var(--accent); font-weight: 900; letter-spacing: -0.04em; }
  .publication-title { display: inline-block; margin-bottom: 0.55rem; color: var(--accent-deep); font-size: 1.08rem; font-weight: 850; line-height: 1.35; text-decoration-thickness: 0.08em; text-underline-offset: 0.2em; }
  .publication-authors { margin-bottom: 0.7rem; color: var(--muted); line-height: 1.65; }
  .publication-meta { display: flex; flex-wrap: wrap; gap: 0.45rem; margin-bottom: 0; }
  .publication-meta span { border-radius: 999px; padding: 0.25rem 0.65rem; background: var(--accent-soft); color: var(--accent-deep); font-size: 0.82rem; font-weight: 800; }
  @media (max-width: 640px) { .publication-item { padding: 3rem 1rem 1rem; } }
</style>
