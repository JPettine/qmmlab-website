---
import { existsSync, readdirSync, readFileSync } from 'node:fs';
import { join, parse } from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';
import FormattedText from '../components/FormattedText.astro';

type ResearchEntry = {
  id: string;
  order: number;
  label: string;
  title: string;
  paragraphs: { text: string; isImageCaption: boolean }[];
  image: string;
};

const researchDir = join(process.cwd(), 'public', 'research');
const imageExtensions = new Set(['.png', '.jpg', '.jpeg', '.webp', '.avif', '.gif', '.svg']);

const readResearchEntries = (section: 'questions' | 'approaches', fallbackTitles: string[]) => {
  const files = existsSync(researchDir) ? readdirSync(researchDir) : [];
  return files
    .map((fileName) => {
      const match = fileName.match(new RegExp(`^${section}(\\d+)_(.+)\\.txt$`, 'i'));
      if (!match) return null;

      const order = Number(match[1]);
      const label = match[2];
      const content = readFileSync(join(researchDir, fileName), 'utf8').trim();
      const [title = fallbackTitles[order - 1] ?? `${section} ${order}`, ...paragraphBlocks] = content
        .split(/\r?\n[ \t]*\r?\n/)
        .map((part) => part.trim())
        .filter(Boolean);
      const displayParagraphs = paragraphBlocks.filter((paragraph) => !paragraph.toLowerCase().startsWith('home snippet:'));
      const imageCaptionIndex = /^Image:/i.test(displayParagraphs.at(-1) ?? '') ? displayParagraphs.length - 1 : -1;
      const paragraphs = displayParagraphs.map((paragraph, index) => ({
        text: paragraph,
        isImageCaption: index === imageCaptionIndex,
      }));
      const imageFile = files.find((candidate) => {
        const parsed = parse(candidate);
        return parsed.name === `${section}${order}_${label}` && imageExtensions.has(parsed.ext.toLowerCase());
      });

      return {
        id: `${section}${order}`,
        order,
        label,
        title,
        paragraphs,
        image: imageFile ? `/research/${imageFile}` : '',
      };
    })
    .filter((entry): entry is ResearchEntry => Boolean(entry))
    .sort((a, b) => a.order - b.order);
};

const researchQuestions = readResearchEntries('questions', [
  'Programmable lattices',
  'Correlated phases',
  'Theory + design',
]);

const experimentalApproaches = readResearchEntries('approaches', [
  'Metasurface modes',
  'Quantum devices',
]);

---

<BaseLayout title="Research | QMM Lab" description="Research themes and projects from QMM Lab.">
  <section class="research-section" aria-labelledby="research-questions-title" id="research-questions">
    <div class="section-heading">
      <p class="eyebrow" id="research-questions-title">Research Topics</p>
    </div>
    <div class="research-card-grid">
      {researchQuestions.map((entry) => (
        <article class:list={["panel", "research-entry", "has-image", !entry.image && "has-placeholder"]} id={entry.id}>
          {entry.image ? (
            <img class="research-entry-image" src={entry.image} alt="" loading="lazy" />
          ) : (
            <div class="research-entry-image research-entry-placeholder">{entry.id === 'approaches2' ? 'Coming soon!' : ''}</div>
          )}
          <div class="research-entry-copy">
            <h2>{entry.title}</h2>
            {entry.paragraphs.map((paragraph) => (
              <p>
                {paragraph.isImageCaption ? (
                  <><strong>Image</strong>: <FormattedText text={paragraph.text.replace(/^Image:\s*/i, '')} /></>
                ) : (
                  <FormattedText text={paragraph.text} />
                )}
              </p>
            ))}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="research-section" aria-labelledby="experimental-approaches-title" id="experimental-approaches">
    <div class="section-heading">
      <p class="eyebrow" id="experimental-approaches-title">Experimental Approaches</p>
    </div>
    <div class="research-card-grid">
      {experimentalApproaches.map((entry) => (
        <article class:list={["panel", "research-entry", "has-image", !entry.image && "has-placeholder"]} id={entry.id}>
          {entry.image ? (
            <img class="research-entry-image" src={entry.image} alt="" loading="lazy" />
          ) : (
            <div class="research-entry-image research-entry-placeholder">{entry.id === 'approaches2' ? 'Coming soon!' : ''}</div>
          )}
          <div class="research-entry-copy">
            <h2>{entry.title}</h2>
            {entry.paragraphs.map((paragraph) => (
              <p>
                {paragraph.isImageCaption ? (
                  <><strong>Image</strong>: <FormattedText text={paragraph.text.replace(/^Image:\s*/i, '')} /></>
                ) : (
                  <FormattedText text={paragraph.text} />
                )}
              </p>
            ))}
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .research-section {
    display: grid;
    gap: 1.5rem;
    scroll-margin-top: 2rem;
  }

  .section-heading {
    max-width: 760px;
  }

  .research-card-grid {
    display: grid;
    gap: 1rem;
  }

  .research-entry {
    scroll-margin-top: 5rem;
  }

  .research-entry.has-image {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    align-items: start;
    gap: clamp(1rem, 3vw, 1.75rem);
  }

  .research-entry-image {
    width: 100%;
    aspect-ratio: 4 / 3;
    border-radius: 18px;
    object-fit: contain;
    background: #ffffff;
  }


  #approaches3 .research-entry-image {
    object-fit: cover;
  }

  .research-entry-placeholder {
    display: grid;
    place-items: center;
    padding: 0;
    background: linear-gradient(135deg, #dddddd, #f1f1f1);
    color: var(--text-muted);
    font-family: var(--font-heading);
    font-size: clamp(1rem, 2vw, 1.25rem);
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .research-entry-copy p {
    text-align: justify;
  }

  .research-entry-copy sub {
    font-size: 0.65em;
    line-height: 0;
  }

  .research-entry p:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 760px) {
    .research-entry.has-image {
      grid-template-columns: 1fr;
    }
  }
</style>
