---
import { existsSync, readdirSync, readFileSync } from 'node:fs';
import { extname, join, parse } from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';

type ResearchEntry = {
  id: string;
  title: string;
  paragraphs: string[];
  image: string;
  number: number;
};

const researchDir = join(process.cwd(), 'public', 'research');
const imageExtensions = new Set(['.png', '.jpg', '.jpeg', '.webp', '.avif', '.svg']);

const readResearchEntries = (kind: 'questions' | 'approaches'): ResearchEntry[] => existsSync(researchDir)
  ? readdirSync(researchDir)
      .map((fileName) => {
        const match = fileName.match(new RegExp(`^${kind}(\\d+)_.+\\.txt$`, 'i'));
        if (!match) return null;

        const stem = parse(fileName).name;
        const content = readFileSync(join(researchDir, fileName), 'utf8').trim();
        const [title = stem, ...paragraphs] = content
          .split(/\r?\n\r?\n/)
          .map((part) => part.trim())
          .filter(Boolean);
        const imageFile = readdirSync(researchDir).find((candidate) => {
          const parsed = parse(candidate);
          return parsed.name === stem && imageExtensions.has(parsed.ext.toLowerCase());
        });

        return {
          id: stem,
          title,
          paragraphs,
          image: imageFile ? `/research/${imageFile}` : '',
          number: Number(match[1]),
        };
      })
      .filter((entry): entry is ResearchEntry => Boolean(entry))
      .sort((a, b) => a.number - b.number)
  : [];

const researchQuestions = readResearchEntries('questions');
const experimentalApproaches = readResearchEntries('approaches');
---

<BaseLayout title="Research | QMM Lab" description="Research themes and projects from QMM Lab.">
  <section class="research-section" aria-labelledby="research-questions-title" id="research-questions">
    <div class="section-heading">
      <p class="eyebrow" id="research-questions-title">Research Questions</p>
    </div>
    <div class="research-card-grid">
      {researchQuestions.map((entry) => (
        <article class="panel research-entry" id={entry.id}>
          {entry.image && <img class="research-entry-image" src={entry.image} alt="" loading="lazy" />}
          <div class="research-entry-copy">
            <h2>{entry.title}</h2>
            {entry.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="research-section" aria-labelledby="experimental-approaches-title" id="experimental-approaches">
    <div class="section-heading">
      <p class="eyebrow" id="experimental-approaches-title">Experimental Approaches</p>
    </div>
    <div class="research-card-grid">
      {experimentalApproaches.map((entry) => (
        <article class="panel research-entry" id={entry.id}>
          {entry.image && <img class="research-entry-image" src={entry.image} alt="" loading="lazy" />}
          <div class="research-entry-copy">
            <h2>{entry.title}</h2>
            {entry.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .research-section {
    display: grid;
    gap: 1.5rem;
    scroll-margin-top: 2rem;
  }

  .section-heading {
    max-width: 760px;
  }

  .research-card-grid {
    display: grid;
    gap: 1rem;
  }

  .research-entry {
    display: grid;
    grid-template-columns: minmax(12rem, 0.42fr) minmax(0, 1fr);
    gap: clamp(1rem, 3vw, 1.5rem);
    align-items: center;
    scroll-margin-top: 5rem;
  }

  .research-entry-image {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 2;
    border-radius: 18px;
    object-fit: cover;
    background: var(--accent-soft);
  }

  .research-entry-copy p:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 720px) {
    .research-entry {
      grid-template-columns: 1fr;
    }
  }
</style>
