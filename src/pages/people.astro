---
import { existsSync, readdirSync, readFileSync } from 'node:fs';
import { extname, join, parse } from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';

const teamDir = join(process.cwd(), 'public', 'team');
const imageExtensions = new Set(['.jpg', '.jpeg', '.png', '.webp', '.avif']);
const pdfExtensions = new Set(['.pdf']);

const imagesDir = join(process.cwd(), 'public', 'images');
const imageFiles = existsSync(imagesDir) ? readdirSync(imagesDir) : [];
const findIcon = (stem: string) => {
  const iconFile = imageFiles.find((fileName) => parse(fileName).name === stem);
  return iconFile ? `/images/${iconFile}` : '';
};

const profileIconByLabel = {
  'Google Scholar': findIcon('Icon_Scholar'),
  LinkedIn: findIcon('Icon_LinkedIn'),
  Instagram: findIcon('Icon_Instagram'),
  X: findIcon('Icon_X'),
};

const formatName = (fileStem: string) => fileStem.replace(/([a-z])([A-Z])/g, '$1 $2');

const teamFiles = existsSync(teamDir) ? readdirSync(teamDir) : [];

const teamMembers = teamFiles
  .filter((fileName) => extname(fileName).toLowerCase() === '.txt')
  .map((fileName) => {
    const fileStem = parse(fileName).name;
    const textPath = join(teamDir, fileName);
    const [position = '', email = '', ...detailLines] = readFileSync(textPath, 'utf8')
      .split(/\r?\n/)
      .map((line) => line.trim())
      .filter(Boolean);
    const profileLinks = detailLines
      .filter((line) => /^https?:\/\//i.test(line))
      .map((url) => {
        const lowerUrl = url.toLowerCase();
        if (lowerUrl.includes('scholar.google.com')) return { url, label: 'Google Scholar', icon: 'G', iconImage: profileIconByLabel['Google Scholar'] };
        if (lowerUrl.includes('linkedin.com')) return { url, label: 'LinkedIn', icon: 'in', iconImage: profileIconByLabel.LinkedIn };
        if (lowerUrl.includes('instagram.com')) return { url, label: 'Instagram', icon: 'ig', iconImage: profileIconByLabel.Instagram };
        if (lowerUrl.includes('twitter.com') || lowerUrl.includes('x.com')) return { url, label: 'X', icon: '𝕏', iconImage: profileIconByLabel.X };
        return null;
      })
      .filter((link): link is { url: string; label: string; icon: string; iconImage: string } => Boolean(link));
    const note = detailLines.filter((line) => !/^https?:\/\//i.test(line)).join(' ');
    const imageFile = teamFiles.find((candidate) => {
      const parsed = parse(candidate);
      return parsed.name === fileStem && imageExtensions.has(parsed.ext.toLowerCase());
    });
    const cvFile = teamFiles.find((candidate) => {
      const parsed = parse(candidate);
      return parsed.name === `${fileStem}_CV` && pdfExtensions.has(parsed.ext.toLowerCase());
    });

    return {
      name: formatName(fileStem),
      position,
      email,
      note,
      profileLinks,
      cv: cvFile ? `/team/${cvFile}` : '',
      image: imageFile ? `/team/${imageFile}` : '',
      slug: fileStem,
    };
  })
  .sort((a, b) => a.name.localeCompare(b.name));
---

<BaseLayout title="People | QMM Lab" description="People and collaborators in the QMM Lab.">
  <section class="team-section" aria-labelledby="current-members-title">
    <div class="section-heading">
      <p class="eyebrow" id="current-members-title">Current Members</p>
    </div>
    <div class="panel team-panel">
      {teamMembers.length > 0 ? (
        <div class="team-grid">
          {teamMembers.map((member) => (
            <article class="team-card" data-member={member.slug}>
              <div class="team-photo-frame">
              {member.image ? (
                <img src={member.image} alt={`${member.name} headshot`} loading="lazy" />
              ) : (
                <div class="team-photo-placeholder" aria-hidden="true">{member.name.charAt(0)}</div>
              )}
              </div>
              <div class="team-card-copy">
              <h3>{member.name}</h3>
              {member.position && <p class="team-position">{member.position}</p>}
              {member.email && <a class="team-email" href={`mailto:${member.email}`}>{member.email}</a>}
              {(member.profileLinks.length > 0 || member.cv) && (
                <div class="profile-links" aria-label={`${member.name} profile links`}>
                  {member.profileLinks.map((link) => (
                    <a class="profile-link" href={link.url} aria-label={link.label} title={link.label} target="_blank" rel="noreferrer">
                      {link.iconImage ? <img src={link.iconImage} alt="" loading="lazy" /> : <span>{link.icon}</span>}
                    </a>
                  ))}
                  {member.cv && <a class="team-cv" href={member.cv}>CV</a>}
                </div>
              )}
              {member.note && <p class="team-note">{member.note}</p>}
              </div>
            </article>
          ))}
        </div>
      ) : (
        <p class="lede">Add files like <code>FirstnameLastname.jpg</code> and <code>FirstnameLastname.txt</code> to <code>public/team/</code>. Put position on the first line, email on the second line, and an optional note on the third line.</p>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .team-section {
    display: grid;
    gap: 0.85rem;
  }

  .section-heading {
    max-width: 760px;
  }

  .team-panel {
    display: grid;
    gap: 1.4rem;
  }

  code {
    border-radius: 0.35rem;
    padding: 0.08rem 0.32rem;
    background: var(--accent-soft);
    color: var(--accent-deep);
    font-size: 0.9em;
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: clamp(1.5rem, 4vw, 2.5rem);
  }

  .team-card {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr);
    align-items: start;
    gap: 1.2rem;
    border: 1px solid var(--line);
    border-radius: 24px;
    padding: 1rem;
    background: linear-gradient(180deg, var(--surface-warm), var(--surface));
  }

  .team-photo-frame {
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 18px;
    background: var(--accent-soft);
  }

  .team-photo-frame img,
  .team-photo-placeholder {
    width: 100%;
    height: 100%;
  }

  .team-photo-frame img {
    display: block;
    object-fit: cover;
    object-position: center;
  }

  .team-card[data-member="JacobPettine"] .team-photo-frame img {
    object-position: 52% 32%;
    transform: scale(1.35);
  }

  .team-card[data-member="YunfanHu"] .team-photo-frame img {
    object-position: center 28%;
  }

  .team-photo-placeholder {
    display: grid;
    place-items: center;
    color: var(--accent);
    font-size: 4rem;
    font-weight: 900;
  }

  .team-card-copy {
    display: grid;
    gap: 0.45rem;
    padding: 0;
  }

  .team-card h3,
  .team-card p {
    margin-bottom: 0;
  }

  .team-card h3 {
    font-size: 1.15rem;
    line-height: 1.2;
  }

  .team-position,
  .team-note {
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.55;
  }


  .profile-links {
    display: flex;
    margin-top: 0.25rem;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
  }

  .profile-link {
    display: inline-grid;
    width: 1.55rem;
    height: 1.55rem;
    place-items: center;
    border: 1px solid rgb(181 22 31 / 18%);
    border-radius: 999px;
    background: #ffffff;
    color: var(--accent-deep);
    font-size: 0.72rem;
    font-weight: 900;
    line-height: 1;
    text-decoration: none;
  }

  .profile-link img {
    width: 72%;
    height: 72%;
    object-fit: contain;
  }

  .profile-link:hover,
  .profile-link:focus-visible {
    background: var(--accent-soft);
    color: var(--accent);
  }

  .team-cv {
    color: var(--accent-deep);
    font-weight: 900;
    text-decoration-color: rgb(181 22 31 / 28%);
    text-underline-offset: 0.2em;
  }

  .team-email {
    color: var(--accent-deep);
    font-weight: 800;
    text-decoration-color: rgb(181 22 31 / 28%);
    text-underline-offset: 0.2em;
  }

  @media (max-width: 520px) {
    .team-card {
      grid-template-columns: 1fr;
    }

    .team-photo-frame {
      width: 8rem;
    }
  }
</style>
