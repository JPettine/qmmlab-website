---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="News | QMM Lab" description="News and updates from QMM Lab.">
  <section class="hero">
    <p class="eyebrow">News</p>
    <h1>Lab updates</h1>
    <p class="tagline">Share announcements, awards, publications, events, and recruiting updates.</p>
  </section>
  <section class="panel">
    <h2>Updates coming soon</h2>
    <p class="lede">This page can later become a blog-style archive powered by Astro content collections.</p>
  </section>
</BaseLayout>
