---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'QMM Lab',
  description = 'Research lab website for QMM Lab.',
} = Astro.props;

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/research/', label: 'Research' },
  { href: '/people/', label: 'Team' },
  { href: '/news/', label: 'News' },
  { href: '/contact/', label: 'Contact' },
  { href: '/openings/', label: 'Openings' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <img
      class="site-banner-image"
      src="/images/QMMLab_Banner.png"
      alt="QMM Lab banner"
      width="13575"
      height="2584"
    />

    <header class="site-header" aria-label="QMM Lab site header">
      <a class="brand" href="/" aria-label="QMM Lab home">
        <span class="brand-mark" aria-hidden="true">QMM</span>
        <span class="brand-name">Lab</span>
      </a>
      <nav class="site-nav" aria-label="Main navigation">
        {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div>
        <strong>QMM Lab</strong>
        <p>Quantum Meta-Matter research group</p>
      </div>
      <p>© {new Date().getFullYear()} QMM Lab.</p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --accent: #b5161f;
    --accent-deep: #7d0d14;
    --accent-soft: #fff1f2;
    --surface: #ffffff;
    --surface-warm: #fffafa;
    --text: #171717;
    --muted: #666666;
    --line: #ece7e7;
    --shadow: 0 18px 60px rgb(125 13 20 / 10%);
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
      "Segoe UI", sans-serif;
  }

  * {
    box-sizing: border-box;
  }

  html {
    background: var(--surface);
  }

  body {
    margin: 0;
    min-height: 100vh;
    overflow-x: hidden;
    background: var(--surface);
    color: var(--text);
  }

  .site-banner-image {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
    aspect-ratio: 13575 / 2584;
  }

  a {
    color: inherit;
  }

  .site-header,
  .site-footer,
  main {
    width: min(1180px, calc(100% - 2rem));
    margin-inline: auto;
  }

  .site-header {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 1.5rem;
    padding: 1.1rem 0 0.9rem;
    border-bottom: 1px solid var(--line);
    background: var(--surface);
  }

  .brand {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
    color: var(--accent);
    font-weight: 900;
    letter-spacing: -0.05em;
    text-decoration: none;
  }

  .brand-mark {
    font-size: clamp(1.35rem, 4vw, 2rem);
    line-height: 1;
  }

  .brand-name {
    color: var(--text);
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: 0;
  }

  .site-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.45rem;
  }

  .site-nav a {
    border: 1px solid transparent;
    border-radius: 999px;
    padding: 0.68rem 0.95rem;
    color: var(--muted);
    font-size: 0.92rem;
    font-weight: 800;
    text-decoration: none;
    transition:
      border-color 160ms ease,
      background 160ms ease,
      color 160ms ease;
  }

  .site-nav a:hover,
  .site-nav a:focus-visible {
    border-color: rgb(181 22 31 / 18%);
    background: var(--accent-soft);
    color: var(--accent-deep);
  }

  main {
    display: grid;
    gap: clamp(2.5rem, 7vw, 5rem);
    padding: clamp(1.4rem, 4vw, 2.5rem) 0 clamp(3rem, 8vw, 6rem);
  }

  .hero,
  .panel,
  .card {
    border: 1px solid var(--line);
    border-radius: 30px;
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  .hero {
    padding: clamp(2rem, 7vw, 5rem);
  }

  .panel {
    padding: clamp(1.5rem, 5vw, 3rem);
  }

  .eyebrow {
    margin: 0 0 1rem;
    color: var(--accent);
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  h1 {
    margin-bottom: 1rem;
    font-size: clamp(3rem, 10vw, 6.5rem);
    line-height: 0.95;
    letter-spacing: -0.07em;
  }

  h2 {
    margin-bottom: 1rem;
    font-size: clamp(1.7rem, 4vw, 2.7rem);
    line-height: 1;
    letter-spacing: -0.045em;
  }

  h3 {
    margin-bottom: 0.65rem;
    letter-spacing: -0.025em;
  }

  .tagline,
  .lede,
  .muted {
    color: var(--muted);
    line-height: 1.7;
  }

  .tagline {
    max-width: 48rem;
    font-size: clamp(1.1rem, 3vw, 1.5rem);
  }

  .actions,
  .card-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }

  .actions {
    margin-top: 2rem;
  }

  .button,
  .actions a {
    border-radius: 999px;
    padding: 0.85rem 1.2rem;
    background: var(--accent);
    color: white;
    font-weight: 800;
    text-decoration: none;
  }

  .button.secondary,
  .actions a:last-child {
    background: transparent;
    color: var(--accent-deep);
    box-shadow: inset 0 0 0 1px rgb(181 22 31 / 24%);
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }

  .card {
    padding: 1.35rem;
  }

  .panel ul {
    margin: 0;
    padding-left: 1.25rem;
    color: var(--muted);
    line-height: 1.8;
  }

  .site-footer {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding: 2rem 0 3rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.95rem;
  }

  .site-footer strong {
    color: var(--accent);
  }

  .site-footer p {
    margin-bottom: 0;
  }

  @media (max-width: 760px) {
    .site-header {
      grid-template-columns: 1fr;
      align-items: flex-start;
    }

    .site-nav {
      justify-content: flex-start;
    }

    .site-footer {
      flex-direction: column;
    }
  }
</style>
