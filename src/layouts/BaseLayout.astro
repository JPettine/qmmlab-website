---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'QMM Lab',
  description = 'Research lab website for QMM Lab.',
} = Astro.props;

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/research/', label: 'Research' },
  { href: '/people/', label: 'Team' },
  { href: '/publications/', label: 'Publications' },
  { href: '/news/', label: 'News' },
  { href: '/contact/', label: 'Contact' },
  { href: '/openings/', label: 'Openings' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header" aria-label="QMM Lab site header">
      <a class="site-banner" href="/" aria-label="QMM Lab home">
        <img src="/banner_qmmlab.svg" alt="QMM Lab: Quantum Meta Matter Lab" />
      </a>

      <div class="menu-bar">
        <a class="university-brand" href="https://www.stonybrook.edu/" aria-label="Stony Brook University">
          <img src="/stony-brook-logo.svg" alt="Stony Brook University" />
        </a>
        <nav class="site-nav" aria-label="Main navigation">
          {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div>
        <strong>QMM Lab</strong>
        <p>Quantum Meta-Matter research group</p>
      </div>
      <p>© {new Date().getFullYear()} QMM Lab.</p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --accent: #b5161f;
    --accent-deep: #7d0d14;
    --accent-soft: #fff3f4;
    --surface: #ffffff;
    --surface-warm: #fffafa;
    --text: #171717;
    --muted: #666666;
    --line: #e6e1e1;
    --shadow: 0 10px 28px rgb(125 13 20 / 8%);
    --radius: 8px;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
      "Segoe UI", sans-serif;
  }

  * {
    box-sizing: border-box;
  }

  html {
    overflow-x: hidden;
    background: var(--surface);
  }

  body {
    margin: 0;
    min-width: 0;
    min-height: 100vh;
    overflow-x: hidden;
    background: var(--surface);
    color: var(--text);
  }

  img,
  svg,
  video {
    max-width: 100%;
    height: auto;
  }

  a {
    color: inherit;
  }

  .site-header {
    width: 100%;
    background: var(--surface);
  }

  .site-banner {
    display: block;
    width: 100%;
    line-height: 0;
    text-decoration: none;
  }

  .site-banner img {
    display: block;
    width: 100%;
  }

  .menu-bar {
    display: grid;
    grid-template-columns: minmax(180px, 330px) 1fr;
    align-items: center;
    gap: clamp(0.75rem, 2vw, 2rem);
    width: min(1180px, calc(100% - 2rem));
    margin-inline: auto;
    padding: 0.8rem 0;
    border-bottom: 1px solid var(--line);
  }

  .university-brand {
    display: inline-flex;
    align-items: center;
    min-width: 0;
    line-height: 0;
  }

  .university-brand img {
    display: block;
    width: min(100%, 330px);
    max-height: 54px;
    object-fit: contain;
    object-position: left center;
  }

  .site-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.15rem;
    min-width: 0;
  }

  .site-nav a {
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 0.58rem 0.72rem;
    color: var(--muted);
    font-size: clamp(0.82rem, 1.2vw, 0.95rem);
    font-weight: 800;
    text-decoration: none;
    white-space: nowrap;
    transition:
      border-color 160ms ease,
      background 160ms ease,
      color 160ms ease;
  }

  .site-nav a:hover,
  .site-nav a:focus-visible {
    border-color: rgb(181 22 31 / 18%);
    background: var(--accent-soft);
    color: var(--accent-deep);
  }

  .site-footer,
  main {
    width: min(1120px, calc(100% - 2rem));
    margin-inline: auto;
  }

  main {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    padding: clamp(1rem, 2vw, 1.5rem) 0 clamp(3rem, 8vw, 6rem);
  }

  .hero,
  .panel,
  .card {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  .hero {
    padding: clamp(2rem, 7vw, 5rem);
  }

  .panel {
    padding: clamp(1.5rem, 5vw, 3rem);
  }

  .eyebrow {
    margin: 0 0 1rem;
    color: var(--accent);
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  h1 {
    margin-bottom: 1rem;
    font-size: clamp(3rem, 10vw, 6.5rem);
    line-height: 0.95;
    letter-spacing: -0.07em;
  }

  h2 {
    margin-bottom: 1rem;
    font-size: clamp(1.7rem, 4vw, 2.7rem);
    line-height: 1;
    letter-spacing: -0.045em;
  }

  h3 {
    margin-bottom: 0.65rem;
    letter-spacing: -0.025em;
  }

  .tagline,
  .lede,
  .muted {
    color: var(--muted);
    line-height: 1.7;
  }

  .tagline {
    max-width: 48rem;
    font-size: clamp(1.1rem, 3vw, 1.5rem);
  }

  .actions,
  .card-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }

  .actions {
    margin-top: 2rem;
  }

  .button,
  .actions a {
    border-radius: 4px;
    padding: 0.85rem 1.2rem;
    background: var(--accent);
    color: white;
    font-weight: 800;
    text-decoration: none;
  }

  .button.secondary,
  .actions a:last-child {
    background: transparent;
    color: var(--accent-deep);
    box-shadow: inset 0 0 0 1px rgb(181 22 31 / 24%);
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }

  .card {
    padding: 1.35rem;
  }

  .panel ul {
    margin: 0;
    padding-left: 1.25rem;
    color: var(--muted);
    line-height: 1.8;
  }

  .site-footer {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding: 2rem 0 3rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.95rem;
  }

  .site-footer strong {
    color: var(--accent);
  }

  .site-footer p {
    margin-bottom: 0;
  }

  @media (max-width: 880px) {
    .menu-bar {
      grid-template-columns: 1fr;
      gap: 0.65rem;
    }

    .site-nav {
      justify-content: flex-start;
    }
  }

  @media (max-width: 640px) {
    .menu-bar,
    .site-footer,
    main {
      width: min(100% - 1rem, 1120px);
    }

    .university-brand img {
      max-height: 42px;
    }

    .site-nav a {
      padding: 0.5rem 0.55rem;
    }

    .site-footer {
      flex-direction: column;
    }
  }
</style>
