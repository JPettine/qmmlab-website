---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'QMM Lab',
  description = 'Research lab website for QMM Lab.',
} = Astro.props;

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/people/', label: 'People' },
  { href: '/research/', label: 'Research' },
  { href: '/publications/', label: 'Publications' },
  { href: '/news/', label: 'News' },
  { href: '/contact/', label: 'Contact' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <div class="site-banner" role="img" aria-label="QMM Lab banner" data-site-banner>
      <span class="site-banner__fallback">QMM Lab</span>
    </div>
    <script is:inline>
      const banner = document.querySelector('[data-site-banner]');
      const bannerSources = [
        '/QMMLab_Banner.png',
        '/QMMLab_Banner.PNG',
        '/assets/QMMLab_Banner.png',
        '/assets/QMMLab_Banner.PNG',
      ];

      const loadBanner = (sources) => {
        const [source, ...remainingSources] = sources;

        if (!banner || !source) {
          return;
        }

        const image = new Image();
        image.onload = () => {
          banner.style.backgroundImage = `url("${source}")`;
          banner.classList.add('site-banner--loaded');
        };
        image.onerror = () => loadBanner(remainingSources);
        image.src = source;
      };

      loadBanner(bannerSources);
    </script>

    <header class="site-header">
      <a class="brand" href="/" aria-label="QMM Lab home">
        <span class="brand-mark" aria-hidden="true">Q</span>
        <span>QMM Lab</span>
      </a>
      <nav class="site-nav" aria-label="Main navigation">
        {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <p>© {new Date().getFullYear()} QMM Lab. Built with Astro.</p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --accent: #4158d0;
    --accent-dark: #1f2f80;
    --surface: #ffffff;
    --text: #172033;
    --muted: #5f6b7a;
    --line: rgb(23 32 51 / 10%);
    --shadow: 0 24px 80px rgb(31 47 128 / 14%);
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
      "Segoe UI", sans-serif;
  }

  * {
    box-sizing: border-box;
  }

  body {
    overflow-x: clip;
    margin: 0;
    min-height: 100vh;
    background:
      radial-gradient(circle at top left, rgb(65 88 208 / 18%), transparent 32rem),
      linear-gradient(135deg, #f7f9ff 0%, #eef4ff 100%);
    color: var(--text);
  }

  a {
    color: inherit;
  }

  .site-banner {
    width: 100%;
    max-width: 100vw;
    height: clamp(8rem, 24vw, 18rem);
    overflow: hidden;
    background-color: #f7f9ff;
    background-image: linear-gradient(135deg, #eef4ff 0%, #dfe8ff 100%);
    background-position: center;
    background-repeat: no-repeat;
    background-size: cover;
  }

  .site-banner__fallback {
    display: grid;
    width: 100%;
    height: 100%;
    place-items: center;
    color: var(--accent-dark);
    font-size: clamp(2.25rem, 8vw, 6rem);
    font-weight: 800;
    letter-spacing: -0.06em;
  }

  .site-banner--loaded .site-banner__fallback {
    opacity: 0;
  }

  .site-header,
  .site-footer,
  main {
    width: min(1120px, calc(100% - 3rem));
    margin-inline: auto;
  }

  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.25rem 0;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--accent-dark);
    font-weight: 800;
    text-decoration: none;
  }

  .brand-mark {
    display: grid;
    width: 2.25rem;
    height: 2.25rem;
    place-items: center;
    border-radius: 0.8rem;
    background: var(--accent);
    color: white;
  }

  .site-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.35rem;
  }

  .site-nav a {
    border-radius: 999px;
    padding: 0.65rem 0.85rem;
    color: var(--muted);
    font-size: 0.95rem;
    font-weight: 700;
    text-decoration: none;
  }

  .site-nav a:hover,
  .site-nav a:focus-visible {
    background: rgb(65 88 208 / 10%);
    color: var(--accent-dark);
  }

  main {
    display: grid;
    gap: 2rem;
    padding: 4rem 0;
  }

  .hero,
  .panel,
  .card {
    border: 1px solid var(--line);
    border-radius: 28px;
    background: rgb(255 255 255 / 78%);
    box-shadow: var(--shadow);
    backdrop-filter: blur(18px);
  }

  .hero {
    padding: clamp(2rem, 7vw, 5rem);
  }

  .panel {
    padding: clamp(1.5rem, 5vw, 3rem);
  }

  .eyebrow {
    margin: 0 0 1rem;
    color: var(--accent-dark);
    font-size: 0.83rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  h1 {
    margin-bottom: 1rem;
    font-size: clamp(3rem, 10vw, 6.5rem);
    line-height: 0.95;
  }

  h2 {
    margin-bottom: 1rem;
    font-size: clamp(1.5rem, 4vw, 2.25rem);
  }

  .tagline,
  .lede,
  .muted {
    color: var(--muted);
    line-height: 1.7;
  }

  .tagline {
    max-width: 44rem;
    font-size: clamp(1.1rem, 3vw, 1.5rem);
  }

  .actions,
  .card-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }

  .actions {
    margin-top: 2rem;
  }

  .button,
  .actions a {
    border-radius: 999px;
    padding: 0.85rem 1.2rem;
    background: var(--accent);
    color: white;
    font-weight: 700;
    text-decoration: none;
  }

  .button.secondary,
  .actions a:last-child {
    background: transparent;
    color: var(--accent-dark);
    box-shadow: inset 0 0 0 1px rgb(31 47 128 / 24%);
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }

  .card {
    padding: 1.3rem;
  }

  .panel ul {
    margin: 0;
    padding-left: 1.25rem;
    color: var(--muted);
    line-height: 1.8;
  }

  .site-footer {
    padding: 2rem 0 3rem;
    color: var(--muted);
    font-size: 0.95rem;
  }

  @media (max-width: 760px) {
    .site-header {
      align-items: flex-start;
      flex-direction: column;
    }

    .site-nav {
      justify-content: flex-start;
    }
  }
</style>
