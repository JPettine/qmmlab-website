---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'QMM Lab',
  description = 'Research lab website for QMM Lab.',
} = Astro.props;

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/research/', label: 'Research' },
  { href: '/people/', label: 'Team' },
  { href: '/news/', label: 'News' },
  { href: '/contact/', label: 'Contact' },
  { href: '/openings/', label: 'Openings' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <img
      class="site-banner-image"
      src="/images/QMMLab_Banner.png"
      alt="QMM Lab banner"
      width="13575"
      height="1984"
    />

    <header class="site-header" aria-label="QMM Lab site header">
      <a class="brand" href="/" aria-label="QMM Lab home">
        <img
          class="brand-logo"
          src="/images/QMMLab_SBULogo.jpg"
          alt="QMM Lab"
          width="986"
          height="158"
        />
      </a>
      <nav class="site-nav" aria-label="Main navigation">
        {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
    </header>


    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div>
        <strong>QMM Lab</strong>
        <p>Quantum Meta-Matter research group</p>
      </div>
      <p>© {new Date().getFullYear()} QMM Lab.</p>
    </footer>
  </body>
</html>

<script>
  const carousels = document.querySelectorAll<HTMLElement>('[data-highlight-carousel]');

  carousels.forEach((carousel) => {
    const track = carousel.querySelector<HTMLElement>('.highlight-track');
    const dots = Array.from(carousel.querySelectorAll<HTMLButtonElement>('[data-highlight-dot]'));
    const slideCount = dots.length;
    let currentSlide = 0;

    if (!track || slideCount < 2) return;

    const showSlide = (slideIndex: number) => {
      currentSlide = slideIndex;
      track.style.transform = `translateX(-${currentSlide * 100}%)`;

      dots.forEach((dot, index) => {
        const isActive = index === currentSlide;
        dot.classList.toggle('is-active', isActive);
        dot.setAttribute('aria-current', isActive ? 'true' : 'false');
      });
    };

    const advanceSlide = () => showSlide((currentSlide + 1) % slideCount);
    window.setInterval(advanceSlide, 5000);

    dots.forEach((dot, index) => {
      dot.addEventListener('click', () => showSlide(index));
    });
  });
</script>

<style is:global>
  :root {
    color-scheme: light;
    --accent: #b5161f;
    --accent-deep: #7d0d14;
    --accent-soft: #fff1f2;
    --surface: #ffffff;
    --surface-warm: #fffafa;
    --text: #171717;
    --muted: #666666;
    --line: #ece7e7;
    --shadow: 0 18px 60px rgb(125 13 20 / 10%);
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
      "Segoe UI", sans-serif;
  }

  * {
    box-sizing: border-box;
  }

  html {
    background: var(--surface);
  }

  body {
    margin: 0;
    min-height: 100vh;
    overflow-x: hidden;
    background: var(--surface);
    color: var(--text);
  }

  .site-banner-image {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
    aspect-ratio: 13575 / 1984;
  }

  a {
    color: inherit;
  }

  .site-header {
    width: calc(100% - 1rem);
    margin-inline: auto;
  }

  .site-footer,
  main {
    width: min(1180px, calc(100% - 2rem));
    margin-inline: auto;
  }

  .site-header {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 1.25rem;
    padding: 0.35rem 0 0.3rem;
    border-bottom: 1px solid var(--line);
    background: var(--surface);
  }

  .brand {
    display: inline-flex;
    text-decoration: none;
  }

  .brand-logo {
    display: block;
    width: auto;
    height: auto;
    max-width: min(34vw, 13rem);
    max-height: 2.1rem;
    object-fit: contain;
    transform: translateX(0.75in);
  }

  .site-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.45rem;
    transform: translateX(-0.5in);
  }

  .site-nav a {
    border: 1px solid transparent;
    border-radius: 999px;
    padding: 0.32rem 0.68rem;
    color: var(--muted);
    font-size: 0.88rem;
    font-weight: 800;
    text-decoration: none;
    transition:
      border-color 160ms ease,
      background 160ms ease,
      color 160ms ease;
  }

  .site-nav a:hover,
  .site-nav a:focus-visible {
    border-color: rgb(181 22 31 / 18%);
    background: var(--accent-soft);
    color: var(--accent-deep);
  }



  .highlight-carousel {
    position: relative;
    width: min(80vw, 1180px);
    margin: 0.35rem auto 0;
    overflow: hidden;
    border-radius: 18px;
  }

  .highlight-track {
    display: flex;
    border-radius: 18px;
    background: #111111;
    transition: transform 676ms ease;
  }

  .highlight-slide {
    position: relative;
    display: grid;
    flex: 0 0 100%;
    margin: 0;
    overflow: hidden;
    border-radius: 18px;
    aspect-ratio: 16 / 7;
    background: var(--line);
  }

  .highlight-slide img {
    display: block;
    width: 80%;
    height: 80%;
    place-self: center;
    border-radius: inherit;
    object-fit: cover;
  }

  .highlight-caption {
    position: absolute;
    inset: 0 0 0 auto;
    display: grid;
    align-content: center;
    width: 35%;
    min-width: 16rem;
    padding: clamp(1rem, 2vw, 1.5rem);
    border-radius: 18px;
    background: rgb(0 0 0 / 65%);
    color: #ffffff;
    opacity: 0;
    transform: translateX(0.75rem);
    transition:
      opacity 180ms ease,
      transform 180ms ease;
  }

  .highlight-carousel:hover .highlight-caption,
  .highlight-carousel:focus-within .highlight-caption {
    opacity: 1;
    transform: translateX(0);
  }

  .highlight-caption strong {
    display: block;
    margin-bottom: 0.65rem;
    font-size: clamp(1rem, 1.8vw, 1.35rem);
    line-height: 1.2;
  }

  .highlight-caption p {
    margin-bottom: 0;
    line-height: 1.55;
  }

  .highlight-dots {
    display: flex;
    justify-content: center;
    gap: 0.4rem;
    margin-top: 0.85rem;
  }

  .highlight-dots button {
    width: 0.5rem;
    height: 0.5rem;
    padding: 0;
    border: 1px solid rgb(181 22 31 / 55%);
    border-radius: 999px;
    background: rgb(181 22 31 / 18%);
  }

  .highlight-dots button.is-active {
    background: var(--accent);
  }

  main {
    display: grid;
    gap: clamp(2.5rem, 7vw, 5rem);
    padding: clamp(1.4rem, 4vw, 2.5rem) 0 clamp(3rem, 8vw, 6rem);
  }

  main > * {
    width: 100%;
    min-width: 0;
  }

  .hero,
  .panel,
  .card {
    border: 1px solid var(--line);
    border-radius: 30px;
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  .hero {
    padding: clamp(2rem, 7vw, 5rem);
  }

  .panel {
    padding: clamp(1.5rem, 5vw, 3rem);
  }

  .eyebrow {
    margin: 0 0 1rem;
    color: var(--accent);
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  h1 {
    margin-bottom: 1rem;
    font-size: clamp(3rem, 10vw, 6.5rem);
    line-height: 0.95;
    letter-spacing: -0.07em;
  }

  h2 {
    margin-bottom: 1rem;
    font-size: clamp(1.7rem, 4vw, 2.7rem);
    line-height: 1;
    letter-spacing: -0.045em;
  }

  h3 {
    margin-bottom: 0.65rem;
    letter-spacing: -0.025em;
  }

  .tagline,
  .lede,
  .muted {
    color: var(--muted);
    line-height: 1.7;
  }

  .tagline {
    max-width: 48rem;
    font-size: clamp(1.1rem, 3vw, 1.5rem);
  }

  .actions,
  .card-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }

  .actions {
    margin-top: 2rem;
  }

  .button,
  .actions a {
    border-radius: 999px;
    padding: 0.85rem 1.2rem;
    background: var(--accent);
    color: white;
    font-weight: 800;
    text-decoration: none;
  }

  .button.secondary,
  .actions a:last-child {
    background: transparent;
    color: var(--accent-deep);
    box-shadow: inset 0 0 0 1px rgb(181 22 31 / 24%);
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }

  .card {
    padding: 1.35rem;
  }

  .panel ul {
    margin: 0;
    padding-left: 1.25rem;
    color: var(--muted);
    line-height: 1.8;
  }

  .site-footer {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding: 2rem 0 3rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.95rem;
  }

  .site-footer strong {
    color: var(--accent);
  }

  .site-footer p {
    margin-bottom: 0;
  }

  @media (max-width: 760px) {

    .highlight-carousel {
      width: calc(100% - 2rem);
    }

    .highlight-slide {
      aspect-ratio: 4 / 3;
    }

    .highlight-caption {
      inset: auto 0 0;
      width: 100%;
      min-width: 0;
      align-content: start;
      border-radius: 18px 18px 0 0;
      transform: translateY(0.75rem);
    }

    .site-header {
      grid-template-columns: 1fr;
      align-items: flex-start;
    }

    .brand {
      margin-left: 0;
    }

    .site-nav {
      justify-content: flex-start;
    }

    .site-footer {
      flex-direction: column;
    }
  }
</style>
