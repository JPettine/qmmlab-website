---
type Props = {
  text: string;
};

const { text } = Astro.props;

const escapeHtml = (value: string) => value
  .replaceAll('&', '&amp;')
  .replaceAll('<', '&lt;')
  .replaceAll('>', '&gt;')
  .replaceAll('"', '&quot;')
  .replaceAll("'", '&#39;');

const renderMath = (math: string) => math
  .split(/(_\{[^}]+\}|\^\{[^}]+\}|_[A-Za-z0-9]+|\^[A-Za-z0-9]+)/g)
  .map((part) => {
    if (!part) return '';
    const marker = part[0];
    if (marker !== '_' && marker !== '^') return escapeHtml(part);

    const value = escapeHtml(part[1] === '{' ? part.slice(2, -1) : part.slice(1));
    return marker === '_' ? `<sub>${value}</sub>` : `<sup>${value}</sup>`;
  })
  .join('');

const html = text
  .split(/(\$[^$]+\$)/g)
  .map((part) => {
    if (!part) return '';
    if (part.startsWith('$') && part.endsWith('$')) return renderMath(part.slice(1, -1));
    return escapeHtml(part);
  })
  .join('');
---

<Fragment set:html={html} />
